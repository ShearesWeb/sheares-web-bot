# Copy to .env and fill in. Values are read by Make, so do not quote them.

# Token of your own bot from @BotFather. Never a deployed bot: those have a webhook and make dev refuses them.
TELEGRAM_BOT_TOKEN=

# Random value configured as Telegram's setWebhook secret_token in deployed environments.
# Local polling does not receive webhooks, but the setting is still required at startup.
TELEGRAM_WEBHOOK_SECRET=local-development-only

# Intranet origin used to build the private /link button.
INTRANET_BASE_URL=http://localhost:3000

# Real DynamoDB tables. Local runs read and write whatever you put here.
USERS_TABLE_NAME=preprod-db-table-sheareswebbot-users
LAUNDRY_TABLE_NAME=preprod-db-table-sheareswebbot-laundry-machines

# Uncomment only to pick a named profile. Left blank, it is exported empty and boto3 rejects it.
# AWS_PROFILE=
AWS_DEFAULT_REGION=ap-southeast-1
